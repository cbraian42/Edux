# Referencia pública del proyecto de DESARROLLO, visible en el Dashboard.
# Registrar el valor al crear el proyecto; no es una credencial de acceso.
SUPABASE_PROJECT_REF=replace-with-development-project-ref

# Variables opcionales para la CLI, no son configuración del backend.
# Preferir supabase login y el ingreso interactivo de la contraseña.
# Nunca completar este archivo versionado: copiarlo a .env si hace falta.
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# La conexión de ejecución del backend se define en el issue #18.
# No se necesitan claves anon/service_role ni variables NEXT_PUBLIC_* aquí.
